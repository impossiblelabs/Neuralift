# Copy to .env for local dev. In GitHub Actions these come from repository variables (Settings → Secrets and variables → Actions → Variables).
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# URL that accepts POST {"email": "...", "source": "landing", "experiments": {...}}. Leave empty for demo mode.
PUBLIC_WAITLIST_ENDPOINT=
